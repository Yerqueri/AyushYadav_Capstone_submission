# ==============================================================================
# CloudServe Support Triage — Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env before running:  cp .env.example .env
# Fill in your OpenAI API Key below.

# ── 1. LLM API Key (Required) ──────────────────────────────────────────────────
# OpenAI API Key (Standard required API key for OpenAI GPT models)
OPENAI_API_KEY=your_openai_api_key_here

# Model Selection (Defaults to gpt-4o-mini)
MODEL_NAME=gpt-4o-mini

# ── 2. Database & Storage ─────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./storage/decisions.db
CHROMA_PATH=./storage/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── 3. Pipeline & Triage Settings ─────────────────────────────────────────────
CONFIDENCE_THRESHOLD=80
RETRIEVAL_TOP_K=8
MAX_COORDINATOR_TURNS=10
LOG_LEVEL=INFO

# ── 4. Docker & Batch Execution Mode Controls ──────────────────────────────────
# Execution mode for Docker container: 'api' (REST API only), 'batch' (One-shot batch run), or 'both'
MODE=batch

# Ingress & Egress volume paths for Docker & batch execution
INPUT_PATH=data/validation_tickets.json
OUTPUT_PATH=storage/results
INGRESS_PATH=data/validation_tickets.json
EGRESS_PATH=storage/results

# Host volume mount overrides for Docker Compose (Optional)
HOST_INGRESS_PATH=./data
HOST_EGRESS_PATH=./storage/results

# Legacy batch keys (supported for backwards compatibility)
BATCH_INPUT=data/validation_tickets.json
BATCH_OUTPUT=storage/results
BATCH_CONCURRENCY=4
# BATCH_SAMPLE=20  # Uncomment to run a quick smoke test on first 20 tickets

# ── 6. Telemetry & Evaluation ───────────────────────────────────────────────────
OTEL_SDK_DISABLED=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cloudserve-triage
